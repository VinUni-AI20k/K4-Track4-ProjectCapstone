# Environment configuration template
# Copy to .env and set your own keys if using Roboflow or Cloud Inference
ROBOFLOW_API_KEY=your_roboflow_api_key_here
ROBOFLOW_WORKSPACE=lais-workspace-haj6t
ROBOFLOW_PROJECT=material-9hzyn
ROBOFLOW_VERSION=1

# Local Model Configuration
YOLO_MODEL_PATH=yolov8n.pt
YOLO_CONF_THRESH=0.35
YOLO_IOU_THRESH=0.45
DEVICE=cpu  # 'cpu' or 'cuda' or '0'
